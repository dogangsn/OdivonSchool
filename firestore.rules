rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Prefer a custom auth claim (request.auth.token.admin == true) set by a
    // trusted Cloud Function once you wire that up - this Firestore-doc check
    // is a reasonable starting point but an extra round-trip per rule eval.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Basic sanity checks so a client cannot store impossible scores.
    // Scoring still happens client-side; moving it to a Cloud Function is
    // the long-term fix.
    function isValidAttempt(a) {
      return a.totalCount is int && a.correctCount is int && a.successRate is int &&
        a.totalCount > 0 && a.totalCount <= 50 &&
        a.correctCount >= 0 && a.correctCount <= a.totalCount &&
        a.successRate >= 0 && a.successRate <= 100 &&
        a.answers is list && a.answers.size() == a.totalCount;
    }

    // Gamification fields the owner's own client updates after a game.
    // Bounds keep a tampered client from minting huge XP in one write; moving
    // XP to a Cloud Function is the long-term fix.
    function isValidProgress(after, before) {
      return after.get('xp', 0) is int &&
        after.get('xp', 0) - before.get('xp', 0) >= 0 &&
        after.get('xp', 0) - before.get('xp', 0) <= 600 &&
        after.get('streakDays', 0) is int &&
        after.get('streakDays', 0) >= 0 && after.get('streakDays', 0) <= 3660 &&
        after.get('badges', []) is list && after.get('badges', []).size() <= 60 &&
        after.get('classIds', []) is list && after.get('classIds', []).size() <= 30;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // People pick student or teacher for themselves ('user' = legacy
      // student). Admin role, teacher verification and every subscription
      // field are only written by admins or trusted backends (Admin SDK).
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['student', 'teacher', 'user'] &&
        request.resource.data.subscriptionStatus == 'none' &&
        !('subscriptionId' in request.resource.data) &&
        !('subscriptionExpiresAt' in request.resource.data) &&
        !('teacherVerified' in request.resource.data) &&
        request.resource.data.get('xp', 0) == 0 &&
        request.resource.data.get('badges', []).size() == 0;
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'gradeLevel', 'grade', 'school', 'branch',
                      'lastNotifSeenAt', 'xp', 'streakDays', 'lastPlayedDate', 'badges',
                      'classIds', 'notifyPush', 'notifyEmail']) &&
          isValidProgress(request.resource.data, resource.data) &&
          request.resource.data.get('notifyPush', true) is bool &&
          request.resource.data.get('notifyEmail', true) is bool);
      allow delete: if isAdmin();

      // Browser/phone push tokens (FCM). Only the owner manages them; the
      // daily digest function reads them with the Admin SDK.
      match /fcmTokens/{tokenId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['token', 'createdAt', 'userAgent']) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() < 4096 &&
          request.resource.data.createdAt is int;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      // Approved questions can be read by anyone (including guests solving trial tests); admins manage drafts.
      allow read: if resource.data.reviewStatus == 'approved' || isAdmin();
      allow write: if isAdmin();
    }

    match /testAttempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidAttempt(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // One document per finished game (Hız Turu, Bilgi Yarışması, Eşleştir).
    match /gameResults/{resultId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.gameType in ['speed', 'quiz', 'match', 'truefalse', 'sort', 'clock', 'numberline', 'fraction'] &&
        request.resource.data.score is int && request.resource.data.score >= 0 &&
        request.resource.data.score <= 100000 &&
        request.resource.data.correct is int && request.resource.data.total is int &&
        request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total &&
        request.resource.data.total <= 500 &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 0 && request.resource.data.stars <= 3;
      allow update, delete: if isAdmin();
    }

    // "Havuza yeni soru eklendi" notices. Written by the admin approval
    // screen, read by every student's notification bell.
    match /poolUpdates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Öğretmen sınıfları
    // ---------------------------------------------------------------------
    function isTeacherOrAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    function isClassTeacher(classId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function isClassMember(classId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function isValidClass(c) {
      return c.name is string && c.name.size() > 0 && c.name.size() <= 60 &&
        c.grade is int && c.grade >= 0 && c.grade <= 12 &&
        c.joinCode is string && c.joinCode.size() == 6;
    }

    function isValidSubmission(s) {
      return s.uid == request.auth.uid &&
        s.score is int && s.score >= 0 && s.score <= 100000 &&
        s.bestScore is int && s.bestScore >= s.score && s.bestScore <= 100000 &&
        s.correct is int && s.total is int && s.correct >= 0 &&
        s.correct <= s.total && s.total <= 500 &&
        s.stars is int && s.stars >= 0 && s.stars <= 3 &&
        s.bestStars is int && s.bestStars >= 0 && s.bestStars <= 3 &&
        s.attempts is int && s.attempts >= 1 && s.attempts <= 1000;
    }

    function isValidClassProgress(p) {
      return p.keys().hasOnly(['uid', 'displayName', 'lastActiveAt', 'streakDays',
                               'activities', 'answered', 'correct', 'topics']) &&
        p.uid == request.auth.uid &&
        p.displayName is string && p.displayName.size() <= 80 &&
        p.lastActiveAt is int && p.streakDays is int &&
        p.activities is int && p.answered is int && p.correct is int &&
        p.correct >= 0 && p.correct <= p.answered &&
        p.topics is map && p.topics.size() <= 400;
    }

    function liveQuestionOpen(classId, sessionId, q) {
      let s = get(/databases/$(database)/documents/classes/$(classId)/live/$(sessionId)).data;
      return s.status == 'question' && s.questionIndex == q &&
        request.time < s.question.startedAt + duration.value(s.question.durationSec + 2, 's');
    }

    function isValidLeague(next, prev) {
      return next.keys().hasOnly(['uid', 'displayName', 'week', 'xp']) &&
        next.uid == request.auth.uid &&
        next.displayName is string && next.displayName.size() <= 80 &&
        next.week is string && next.week.size() <= 10 &&
        next.xp is int && next.xp >= 0 &&
        (((prev == null || prev.week != next.week) && next.xp <= 600) ||
         (prev != null && prev.week == next.week && next.xp >= prev.xp && next.xp - prev.xp <= 600));
    }

    match /classes/{classId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.teacherId == request.auth.uid) ||
        isClassMember(classId);
      allow create: if isSignedIn() && isTeacherOrAdmin() &&
        request.resource.data.teacherId == request.auth.uid &&
        isValidClass(request.resource.data);
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid &&
        request.resource.data.teacherId == request.auth.uid &&
        isValidClass(request.resource.data);
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;

      // Students add themselves with a valid join code; the teacher can
      // remove anyone, a student can leave.
      match /members/{memberId} {
        allow read: if request.auth.uid == memberId || isClassTeacher(classId) || isAdmin();
        allow create: if isSignedIn() && request.auth.uid == memberId &&
          request.resource.data.uid == memberId &&
          request.resource.data.joinCode is string &&
          get(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.classId == classId;
        allow update: if false;
        allow delete: if request.auth.uid == memberId || isClassTeacher(classId);
      }

      // Running totals per student, written by the student's own app after
      // each game or test, read by the teacher for the tracking tab.
      match /progress/{studentId} {
        allow read: if request.auth.uid == studentId || isClassTeacher(classId) || isAdmin();
        allow create, update: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidClassProgress(request.resource.data);
        allow delete: if isClassTeacher(classId);
      }

      // Usernames of accounts the teacher opened (teacher only; never passwords).
      match /accounts/{studentId} {
        allow read, delete: if isClassTeacher(classId);
        allow create: if isClassTeacher(classId) &&
          request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'createdAt']) &&
          request.resource.data.uid == studentId &&
          exists(/databases/$(database)/documents/classes/$(classId)/members/$(studentId));
        allow update: if false;
      }

      // Weekly XP league inside the class; classmates see each other's XP only.
      match /league/{studentId} {
        allow read: if isClassMember(classId) || isClassTeacher(classId) || isAdmin();
        allow create: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidLeague(request.resource.data, null);
        allow update: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidLeague(request.resource.data, resource.data);
        allow delete: if isClassTeacher(classId);
      }

      // Live competition. The teacher's app is the referee: it keeps the
      // answers in `private`, opens questions and writes every score.
      match /live/{sessionId} {
        allow read: if isClassTeacher(classId) || isClassMember(classId) || isAdmin();
        allow create: if isClassTeacher(classId) &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.classId == classId &&
          request.resource.data.status == 'lobby';
        allow update: if isClassTeacher(classId) &&
          request.resource.data.teacherId == resource.data.teacherId &&
          request.resource.data.status in ['lobby', 'question', 'reveal', 'finished'];
        allow delete: if isClassTeacher(classId);

        match /private/{docId} {
          allow read, write: if isClassTeacher(classId);
        }

        match /players/{playerId} {
          allow read: if request.auth.uid == playerId || isClassTeacher(classId);
          allow create: if request.auth.uid == playerId && isClassMember(classId) &&
            request.resource.data.uid == playerId &&
            request.resource.data.displayName is string &&
            request.resource.data.displayName.size() <= 80 &&
            request.resource.data.score == 0 && request.resource.data.correct == 0 &&
            get(/databases/$(database)/documents/classes/$(classId)/live/$(sessionId)).data.status != 'finished';
          allow update, delete: if isClassTeacher(classId);
        }

        // One answer per student per question, stamped with the server time
        // and only while that question is open.
        match /answers/{answerId} {
          allow read: if isClassTeacher(classId) ||
            (isSignedIn() && resource.data.uid == request.auth.uid);
          allow create: if isSignedIn() && isClassMember(classId) &&
            request.resource.data.keys().hasOnly(['uid', 'q', 'choice', 'answeredAt']) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.q is int &&
            answerId == string(request.resource.data.q) + '_' + request.auth.uid &&
            request.resource.data.choice is int &&
            request.resource.data.choice >= 0 && request.resource.data.choice < 6 &&
            request.resource.data.answeredAt == request.time &&
            liveQuestionOpen(classId, sessionId, request.resource.data.q);
          allow update, delete: if false;
        }
      }

      match /assignments/{assignmentId} {
        allow read: if isClassTeacher(classId) || isClassMember(classId) || isAdmin();
        allow create, update: if isClassTeacher(classId) &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.classId == classId &&
          request.resource.data.title is string && request.resource.data.title.size() <= 120;
        allow delete: if isClassTeacher(classId);

        match /submissions/{studentId} {
          allow read: if request.auth.uid == studentId || isClassTeacher(classId) || isAdmin();
          allow create, update: if request.auth.uid == studentId && isClassMember(classId) &&
            isValidSubmission(request.resource.data);
          allow delete: if isClassTeacher(classId);
        }
      }
    }

    // Join code -> class lookup. Readable one code at a time, never listable.
    match /classCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.teacherId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.joinCode == code;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // A teacher's own tests and matching sets. Students get a copy inside
    // each assignment, so only the owner reads these.
    match /teacherContent/{contentId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isTeacherOrAdmin() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type in ['quiz', 'match'] &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type == resource.data.type;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Subscriptions are only ever written by Cloud Functions (payment
      // webhooks) using the Admin SDK, which bypasses these rules entirely.
      allow write: if false;
    }
  }
}
