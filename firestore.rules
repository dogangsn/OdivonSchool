rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Prefer a custom auth claim (request.auth.token.admin == true) set by a
    // trusted Cloud Function once you wire that up - this Firestore-doc check
    // is a reasonable starting point but an extra round-trip per rule eval.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Basic sanity checks so a client cannot store impossible scores.
    // Scoring still happens client-side; moving it to a Cloud Function is
    // the long-term fix.
    function isValidAttempt(a) {
      return a.totalCount is int && a.correctCount is int && a.successRate is int &&
        a.totalCount > 0 && a.totalCount <= 50 &&
        a.correctCount >= 0 && a.correctCount <= a.totalCount &&
        a.successRate >= 0 && a.successRate <= 100 &&
        a.answers is list && a.answers.size() == a.totalCount;
    }

    // Gamification fields the owner's own client updates after a game.
    // Bounds keep a tampered client from minting huge XP in one write; moving
    // XP to a Cloud Function is the long-term fix.
    function isValidProgress(after, before) {
      return after.get('xp', 0) is int &&
        after.get('xp', 0) - before.get('xp', 0) >= 0 &&
        after.get('xp', 0) - before.get('xp', 0) <= 600 &&
        after.get('streakDays', 0) is int &&
        after.get('streakDays', 0) >= 0 && after.get('streakDays', 0) <= 3660 &&
        after.get('badges', []) is list && after.get('badges', []).size() <= 60 &&
        after.get('classIds', []) is list && after.get('classIds', []).size() <= 30;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // People pick student or teacher for themselves ('user' = legacy
      // student). Admin role, teacher verification and every subscription
      // field are only written by admins or trusted backends (Admin SDK).
      allow create: if isOwner(userId) &&
        request.resource.data.role in ['student', 'teacher', 'user'] &&
        request.resource.data.subscriptionStatus == 'none' &&
        !('subscriptionId' in request.resource.data) &&
        !('subscriptionExpiresAt' in request.resource.data) &&
        !('teacherVerified' in request.resource.data) &&
        request.resource.data.get('xp', 0) == 0 &&
        request.resource.data.get('badges', []).size() == 0;
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'gradeLevel', 'grade', 'school', 'branch',
                      'lastNotifSeenAt', 'xp', 'streakDays', 'lastPlayedDate', 'badges',
                      'classIds', 'notifyPush', 'notifyEmail']) &&
          isValidProgress(request.resource.data, resource.data) &&
          request.resource.data.get('notifyPush', true) is bool &&
          request.resource.data.get('notifyEmail', true) is bool);
      allow delete: if isAdmin();

      // Akıllı tekrar: one card per question the student got wrong, and
      // their kazanım totals. Only the student reads and writes them.
      match /reviewCards/{questionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['questionId', 'categoryId', 'subject', 'outcomeCode',
                                                'box', 'dueAt', 'wrongCount', 'updatedAt']) &&
          request.resource.data.questionId == questionId &&
          request.resource.data.categoryId is string &&
          request.resource.data.subject is string && request.resource.data.subject.size() <= 60 &&
          (request.resource.data.outcomeCode == null ||
           (request.resource.data.outcomeCode is string && request.resource.data.outcomeCode.size() <= 60)) &&
          request.resource.data.box is int && request.resource.data.box >= 1 && request.resource.data.box <= 5 &&
          request.resource.data.dueAt is int && request.resource.data.wrongCount is int &&
          request.resource.data.updatedAt is int;
      }

      match /learning/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && docId == 'outcomes' &&
          request.resource.data.keys().hasOnly(['outcomes', 'updatedAt']) &&
          request.resource.data.outcomes is map && request.resource.data.outcomes.size() <= 1500 &&
          request.resource.data.updatedAt is int;
        allow delete: if isOwner(userId);
      }

      // Akıllı Kütüphane: the page each MEB book was left open on.
      match /library/{bookId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['bookId', 'page', 'pageCount', 'updatedAt']) &&
          request.resource.data.bookId is int && string(request.resource.data.bookId) == bookId &&
          request.resource.data.page is int && request.resource.data.page >= 1 &&
          request.resource.data.pageCount is int && request.resource.data.pageCount >= 1 &&
          request.resource.data.pageCount <= 2000 &&
          request.resource.data.page <= request.resource.data.pageCount &&
          request.resource.data.updatedAt is int;
      }

      // Defter Notları > Notlarım: notes the student or teacher writes
      // themselves. Private to the owner.
      match /notes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['title', 'subject', 'grade', 'body', 'color',
                                                'linkedSlug', 'createdAt', 'updatedAt']) &&
          request.resource.data.title is string && request.resource.data.title.size() >= 1 &&
          request.resource.data.title.size() <= 120 &&
          request.resource.data.subject is string && request.resource.data.subject.size() <= 60 &&
          (request.resource.data.grade == null ||
           (request.resource.data.grade is int && request.resource.data.grade >= 1 &&
            request.resource.data.grade <= 12)) &&
          request.resource.data.body is string && request.resource.data.body.size() <= 20000 &&
          request.resource.data.color in ['sari', 'mavi', 'yesil', 'pembe', 'mor'] &&
          (request.resource.data.linkedSlug == null ||
           (request.resource.data.linkedSlug is string && request.resource.data.linkedSlug.size() <= 160)) &&
          request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      }

      // Okuma Kurdu: the books a student finished. Only the student writes;
      // classmates see the per-class bookworm summary instead.
      match /books/{bookId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['title', 'author', 'pages', 'finishedOn', 'rating', 'createdAt']) &&
          request.resource.data.title is string && request.resource.data.title.size() >= 2 &&
          request.resource.data.title.size() <= 120 &&
          request.resource.data.author is string && request.resource.data.author.size() <= 80 &&
          request.resource.data.pages is int && request.resource.data.pages >= 1 &&
          request.resource.data.pages <= 2000 &&
          request.resource.data.finishedOn is string && request.resource.data.finishedOn.size() == 10 &&
          request.resource.data.rating is int && request.resource.data.rating >= 0 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.createdAt is int;
        allow update: if false;
      }

      // Browser/phone push tokens (FCM). Only the owner manages them; the
      // daily digest function reads them with the Admin SDK.
      match /fcmTokens/{tokenId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['token', 'createdAt', 'userAgent']) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() < 4096 &&
          request.resource.data.createdAt is int;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A teacher's question offered to the shared pool: always a draft with
    // id t_<teacherQuestionId>, and only an admin can approve it.
    function isValidTeacherPoolQuestion(questionId, d) {
      return questionId.matches('^t_[A-Za-z0-9]+$') &&
        d.keys().hasOnly(['categoryId', 'level', 'subject', 'grade', 'prompt', 'options', 'correctOptionId',
                          'explanation', 'difficulty', 'outcomeCode', 'source', 'authorId', 'authorName',
                          'reviewStatus', 'createdAt', 'usageCount', 'correctCount']) &&
        d.source == 'teacher' && d.reviewStatus == 'draft' &&
        d.authorId == request.auth.uid &&
        d.authorName is string && d.authorName.size() <= 80 &&
        d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 120 &&
        exists(/databases/$(database)/documents/categories/$(d.categoryId)) &&
        d.subject is string && d.subject.size() <= 60 &&
        d.grade is int && d.grade >= 1 && d.grade <= 12 &&
        d.prompt is string && d.prompt.size() >= 15 && d.prompt.size() <= 1000 &&
        d.options is list && d.options.size() == 4 &&
        d.correctOptionId in ['a', 'b', 'c', 'd'] &&
        d.explanation is string && d.explanation.size() >= 20 && d.explanation.size() <= 1000 &&
        d.difficulty is int && d.difficulty >= 1 && d.difficulty <= 5 &&
        (!('outcomeCode' in d) || (d.outcomeCode is string && d.outcomeCode.size() <= 60)) &&
        d.createdAt is int && d.usageCount == 0 && d.correctCount == 0;
    }

    match /questions/{questionId} {
      // Approved questions can be read by anyone (including guests solving trial tests); admins manage drafts.
      // Teachers also see the copies they offered to the pool.
      allow read: if resource.data.reviewStatus == 'approved' || isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isAdmin() ||
        (isTeacherOrAdmin() && isValidTeacherPoolQuestion(questionId, request.resource.data));
      allow update: if isAdmin();
      // A teacher may take back their own offer while it still waits for review.
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid && resource.data.reviewStatus == 'draft');
    }

    match /testAttempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidAttempt(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // One document per finished game (Hız Turu, Bilgi Yarışması, Eşleştir).
    match /gameResults/{resultId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.gameType in ['speed', 'quiz', 'match', 'truefalse', 'sort', 'clock', 'numberline', 'fraction', 'reading', 'attention'] &&
        request.resource.data.score is int && request.resource.data.score >= 0 &&
        request.resource.data.score <= 100000 &&
        request.resource.data.correct is int && request.resource.data.total is int &&
        request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total &&
        request.resource.data.total <= 500 &&
        request.resource.data.stars is int &&
        request.resource.data.stars >= 0 && request.resource.data.stars <= 3;
      allow update, delete: if isAdmin();
    }

    // "Havuza yeni soru eklendi" notices. Written by the admin approval
    // screen, read by every student's notification bell.
    match /poolUpdates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Öğretmen sınıfları
    // ---------------------------------------------------------------------
    function isTeacherOrAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    function isClassTeacher(classId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function isClassMember(classId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function isValidClass(c) {
      return c.name is string && c.name.size() > 0 && c.name.size() <= 60 &&
        c.grade is int && c.grade >= 0 && c.grade <= 12 &&
        c.joinCode is string && c.joinCode.size() == 6;
    }

    function isValidSubmission(s) {
      return s.uid == request.auth.uid &&
        s.score is int && s.score >= 0 && s.score <= 100000 &&
        s.bestScore is int && s.bestScore >= s.score && s.bestScore <= 100000 &&
        s.correct is int && s.total is int && s.correct >= 0 &&
        s.correct <= s.total && s.total <= 500 &&
        s.stars is int && s.stars >= 0 && s.stars <= 3 &&
        s.bestStars is int && s.bestStars >= 0 && s.bestStars <= 3 &&
        s.attempts is int && s.attempts >= 1 && s.attempts <= 1000;
    }

    function isValidClassProgress(p) {
      return p.keys().hasOnly(['uid', 'displayName', 'lastActiveAt', 'streakDays',
                               'activities', 'answered', 'correct', 'topics', 'outcomes']) &&
        (!('outcomes' in p) || (p.outcomes is map && p.outcomes.size() <= 600)) &&
        p.uid == request.auth.uid &&
        p.displayName is string && p.displayName.size() <= 80 &&
        p.lastActiveAt is int && p.streakDays is int &&
        p.activities is int && p.answered is int && p.correct is int &&
        p.correct >= 0 && p.correct <= p.answered &&
        p.topics is map && p.topics.size() <= 400;
    }

    function liveQuestionOpen(classId, sessionId, q) {
      let s = get(/databases/$(database)/documents/classes/$(classId)/live/$(sessionId)).data;
      return s.status == 'question' && s.questionIndex == q &&
        request.time < s.question.startedAt + duration.value(s.question.durationSec + 2, 's');
    }

    function duelDoc(classId, duelId) {
      return get(/databases/$(database)/documents/classes/$(classId)/duels/$(duelId)).data;
    }

    // A new duel. A student's is a 2-player duel they join at once; a
    // teacher's lists the invited students and the teacher only hosts.
    function isValidNewDuel(classId, d) {
      return d.keys().hasOnly(['classId', 'createdBy', 'creatorName', 'byTeacher', 'title', 'subject',
                               'questions', 'timeLimitSec', 'invited', 'joined', 'maxPlayers',
                               'status', 'startedAt', 'createdAt', 'endedAt']) &&
        d.classId == classId && d.createdBy == request.auth.uid &&
        d.creatorName is string && d.creatorName.size() <= 80 &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 120 &&
        d.subject is string && d.subject.size() <= 40 &&
        d.questions is list && d.questions.size() > 0 && d.questions.size() <= 30 &&
        d.timeLimitSec is int && d.timeLimitSec >= 30 && d.timeLimitSec <= 1800 &&
        d.status == 'waiting' && d.startedAt == null && d.endedAt == null &&
        d.invited is list && d.joined is list &&
        ((d.byTeacher == true && isClassTeacher(classId) &&
          d.joined.size() == 0 && d.invited.size() > 0 && d.invited.size() <= 40 &&
          d.maxPlayers == d.invited.size()) ||
         (d.byTeacher == false && isClassMember(classId) &&
          d.invited.size() == 0 && d.joined == [request.auth.uid] && d.maxPlayers == 2));
    }

    function canHostDuel(classId, d) {
      return d.createdBy == request.auth.uid || isClassTeacher(classId);
    }

    function isValidDuelPlayer(p, total) {
      return p.keys().hasOnly(['uid', 'name', 'joinedAt', 'answered', 'correct', 'score',
                               'durationMs', 'done']) &&
        p.uid == request.auth.uid &&
        p.name is string && p.name.size() <= 80 &&
        p.answered is int && p.answered >= 0 && p.answered <= total &&
        p.correct is int && p.correct >= 0 && p.correct <= p.answered &&
        p.score is int && p.score >= 0 && p.score <= p.correct * 150 &&
        p.durationMs is int && p.durationMs >= 0 && p.done is bool;
    }

    function isValidLeague(next, prev) {
      return next.keys().hasOnly(['uid', 'displayName', 'week', 'xp']) &&
        next.uid == request.auth.uid &&
        next.displayName is string && next.displayName.size() <= 80 &&
        next.week is string && next.week.size() <= 10 &&
        next.xp is int && next.xp >= 0 &&
        (((prev == null || prev.week != next.week) && next.xp <= 600) ||
         (prev != null && prev.week == next.week && next.xp >= prev.xp && next.xp - prev.xp <= 600));
    }

    match /classes/{classId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.teacherId == request.auth.uid) ||
        isClassMember(classId);
      allow create: if isSignedIn() && isTeacherOrAdmin() &&
        request.resource.data.teacherId == request.auth.uid &&
        isValidClass(request.resource.data);
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid &&
        request.resource.data.teacherId == request.auth.uid &&
        isValidClass(request.resource.data);
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;

      // Students add themselves with a valid join code; the teacher can
      // remove anyone, a student can leave.
      match /members/{memberId} {
        allow read: if request.auth.uid == memberId || isClassTeacher(classId) || isAdmin();
        allow create: if isSignedIn() && request.auth.uid == memberId &&
          request.resource.data.uid == memberId &&
          request.resource.data.joinCode is string &&
          get(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.classId == classId;
        allow update: if false;
        allow delete: if request.auth.uid == memberId || isClassTeacher(classId);
      }

      // Running totals per student, written by the student's own app after
      // each game or test, read by the teacher for the tracking tab.
      match /progress/{studentId} {
        allow read: if request.auth.uid == studentId || isClassTeacher(classId) || isAdmin();
        allow create, update: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidClassProgress(request.resource.data);
        allow delete: if isClassTeacher(classId);
      }

      // Usernames of accounts the teacher opened (teacher only; never passwords).
      match /accounts/{studentId} {
        allow read, delete: if isClassTeacher(classId);
        allow create: if isClassTeacher(classId) &&
          request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'createdAt']) &&
          request.resource.data.uid == studentId &&
          exists(/databases/$(database)/documents/classes/$(classId)/members/$(studentId));
        allow update: if false;
      }

      // Weekly XP league inside the class; classmates see each other's XP only.
      match /league/{studentId} {
        allow read: if isClassMember(classId) || isClassTeacher(classId) || isAdmin();
        allow create: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidLeague(request.resource.data, null);
        allow update: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidLeague(request.resource.data, resource.data);
        allow delete: if isClassTeacher(classId);
      }

      // --- reading (sesli okuma) ---
      // Read-aloud summary per student, written by the student's own app after
      // each Sesli Okuma session, read by the teacher. Numbers and struggled
      // words only; audio is never stored.
      function isValidReading(next, prev) {
        return next.keys().hasOnly(['uid', 'displayName', 'sessions', 'lastWcpm', 'bestWcpm',
                                    'lastAccuracy', 'lastTextId', 'lastAt', 'struggled']) &&
          next.keys().hasAll(['uid', 'displayName', 'sessions', 'lastWcpm', 'bestWcpm',
                              'lastAccuracy', 'lastTextId', 'lastAt', 'struggled']) &&
          next.uid == request.auth.uid &&
          next.displayName is string && next.displayName.size() <= 80 &&
          next.sessions is int && next.sessions == (prev == null ? 1 : prev.sessions + 1) &&
          next.lastWcpm is int && next.lastWcpm >= 0 && next.lastWcpm <= 400 &&
          next.bestWcpm is int && next.bestWcpm >= next.lastWcpm && next.bestWcpm <= 400 &&
          (prev == null ? next.bestWcpm == next.lastWcpm
                        : (next.bestWcpm >= prev.bestWcpm &&
                           (next.bestWcpm == prev.bestWcpm || next.bestWcpm == next.lastWcpm))) &&
          next.lastAccuracy is int && next.lastAccuracy >= 0 && next.lastAccuracy <= 100 &&
          next.lastTextId is string && next.lastTextId.size() > 0 && next.lastTextId.size() <= 40 &&
          next.lastAt is int &&
          next.struggled is list && next.struggled.size() <= 20;
      }

      match /reading/{studentId} {
        allow read: if request.auth.uid == studentId || isClassTeacher(classId) || isAdmin();
        allow create: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidReading(request.resource.data, null);
        allow update: if request.auth.uid == studentId && isClassMember(classId) &&
          isValidReading(request.resource.data, resource.data);
        allow delete: if isClassTeacher(classId);
      }
      // --- end reading ---

      // Okuma Kurdu summary per student: books and pages for the class map.
      match /bookworm/{studentId} {
        allow read: if isClassMember(classId) || isClassTeacher(classId) || isAdmin();
        allow create, update: if request.auth.uid == studentId && isClassMember(classId) &&
          request.resource.data.keys().hasOnly(['uid', 'displayName', 'books', 'pages', 'lastTitle', 'lastAt']) &&
          request.resource.data.uid == studentId &&
          request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80 &&
          request.resource.data.books is int && request.resource.data.books >= 0 &&
          request.resource.data.books <= 5000 &&
          request.resource.data.pages is int && request.resource.data.pages >= 0 &&
          request.resource.data.pages <= 10000000 &&
          request.resource.data.lastTitle is string && request.resource.data.lastTitle.size() <= 120 &&
          request.resource.data.lastAt is int;
        allow delete: if isClassTeacher(classId);
      }

      // Live competition. The teacher's app is the referee: it keeps the
      // answers in `private`, opens questions and writes every score.
      match /live/{sessionId} {
        allow read: if isClassTeacher(classId) || isClassMember(classId) || isAdmin();
        allow create: if isClassTeacher(classId) &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.classId == classId &&
          request.resource.data.status == 'lobby';
        allow update: if isClassTeacher(classId) &&
          request.resource.data.teacherId == resource.data.teacherId &&
          request.resource.data.status in ['lobby', 'question', 'reveal', 'finished'];
        allow delete: if isClassTeacher(classId);

        match /private/{docId} {
          allow read, write: if isClassTeacher(classId);
        }

        match /players/{playerId} {
          allow read: if request.auth.uid == playerId || isClassTeacher(classId);
          allow create: if request.auth.uid == playerId && isClassMember(classId) &&
            request.resource.data.uid == playerId &&
            request.resource.data.displayName is string &&
            request.resource.data.displayName.size() <= 80 &&
            request.resource.data.score == 0 && request.resource.data.correct == 0 &&
            get(/databases/$(database)/documents/classes/$(classId)/live/$(sessionId)).data.status != 'finished';
          allow update, delete: if isClassTeacher(classId);
        }

        // One answer per student per question, stamped with the server time
        // and only while that question is open.
        match /answers/{answerId} {
          allow read: if isClassTeacher(classId) ||
            (isSignedIn() && resource.data.uid == request.auth.uid);
          allow create: if isSignedIn() && isClassMember(classId) &&
            request.resource.data.keys().hasOnly(['uid', 'q', 'choice', 'answeredAt']) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.q is int &&
            answerId == string(request.resource.data.q) + '_' + request.auth.uid &&
            request.resource.data.choice is int &&
            request.resource.data.choice >= 0 && request.resource.data.choice < 6 &&
            request.resource.data.answeredAt == request.time &&
            liveQuestionOpen(classId, sessionId, request.resource.data.q);
          allow update, delete: if false;
        }
      }

      // Düello (student, via link) and karşılaşma (teacher picks students).
      // Everyone plays the same questions at once; each player writes only
      // their own progress, and only while the duel is running.
      match /duels/{duelId} {
        allow read: if isClassMember(classId) || isClassTeacher(classId) || isAdmin();
        allow create: if isSignedIn() && isValidNewDuel(classId, request.resource.data);
        allow update: if isSignedIn() && (
          // join: add yourself while waiting, if invited (or the duel is open) and there is room
          (resource.data.status == 'waiting' && isClassMember(classId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined']) &&
           !(request.auth.uid in resource.data.joined) &&
           request.resource.data.joined.toSet() == resource.data.joined.toSet().union([request.auth.uid].toSet()) &&
           request.resource.data.joined.size() == resource.data.joined.size() + 1 &&
           request.resource.data.joined.size() <= resource.data.maxPlayers &&
           (resource.data.invited.size() == 0 || request.auth.uid in resource.data.invited)) ||
          // start: the host presses Başlat
          (resource.data.status == 'waiting' && canHostDuel(classId, resource.data) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt']) &&
           request.resource.data.status == 'running' && request.resource.data.startedAt == request.time &&
           resource.data.joined.size() >= (resource.data.byTeacher ? 1 : 2)) ||
          // finish: the host at any time, a player once time is up
          (resource.data.status in ['waiting', 'running'] &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']) &&
           request.resource.data.status == 'finished' && request.resource.data.endedAt is int &&
           (canHostDuel(classId, resource.data) ||
            (resource.data.status == 'running' && request.auth.uid in resource.data.joined &&
             request.time > resource.data.startedAt + duration.value(resource.data.timeLimitSec + 5, 's'))))
        );
        allow delete: if isSignedIn() && canHostDuel(classId, resource.data);

        match /players/{playerId} {
          allow read: if isClassMember(classId) || isClassTeacher(classId) || isAdmin();
          allow create: if isSignedIn() && request.auth.uid == playerId &&
            request.auth.uid in getAfter(/databases/$(database)/documents/classes/$(classId)/duels/$(duelId)).data.joined &&
            isValidDuelPlayer(request.resource.data, 0) &&
            request.resource.data.done == false;
          allow update: if isSignedIn() && request.auth.uid == playerId &&
            isValidDuelPlayer(request.resource.data, duelDoc(classId, duelId).questions.size()) &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.joinedAt == resource.data.joinedAt &&
            request.resource.data.answered >= resource.data.answered &&
            request.resource.data.correct >= resource.data.correct &&
            request.resource.data.score >= resource.data.score &&
            resource.data.done == false &&
            duelDoc(classId, duelId).status == 'running' &&
            request.time < duelDoc(classId, duelId).startedAt +
              duration.value(duelDoc(classId, duelId).timeLimitSec + 30, 's');
          allow delete: if isClassTeacher(classId);
        }
      }

      // Notes from the teacher to the whole class or to chosen students.
      match /messages/{messageId} {
        allow read: if isClassTeacher(classId) || isAdmin() ||
          (isClassMember(classId) &&
           ('all' in resource.data.audience || request.auth.uid in resource.data.audience));
        allow create: if isClassTeacher(classId) &&
          request.resource.data.keys().hasOnly(['classId', 'teacherId', 'teacherName', 'text', 'audience',
                                                'link', 'linkLabel', 'createdAt']) &&
          request.resource.data.classId == classId &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.teacherName is string && request.resource.data.teacherName.size() <= 80 &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.audience is list && request.resource.data.audience.size() > 0 &&
          request.resource.data.audience.size() <= 60 &&
          (request.resource.data.link == null ||
           (request.resource.data.link is string && request.resource.data.link.size() <= 200 &&
            request.resource.data.link.matches('^/[a-z].*'))) &&
          (request.resource.data.linkLabel == null ||
           (request.resource.data.linkLabel is string && request.resource.data.linkLabel.size() <= 60)) &&
          request.resource.data.createdAt is int;
        allow update: if false;
        allow delete: if isClassTeacher(classId);
      }

      match /assignments/{assignmentId} {
        allow read: if isClassTeacher(classId) || isClassMember(classId) || isAdmin();
        allow create, update: if isClassTeacher(classId) &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.classId == classId &&
          request.resource.data.title is string && request.resource.data.title.size() <= 120;
        allow delete: if isClassTeacher(classId);

        // Sınav: the answer key stays hidden until the student hands in.
        match /examKey/{docId} {
          allow read: if isClassTeacher(classId) || isAdmin() ||
            (isSignedIn() &&
             exists(/databases/$(database)/documents/classes/$(classId)/assignments/$(assignmentId)/examAnswers/$(request.auth.uid)));
          allow write: if isClassTeacher(classId) && docId == 'key';
        }

        // One answer sheet per student, handed in once and never changed.
        match /examAnswers/{studentId} {
          allow read: if request.auth.uid == studentId || isClassTeacher(classId) || isAdmin();
          allow create: if request.auth.uid == studentId && isClassMember(classId) &&
            request.resource.data.keys().hasOnly(['uid', 'displayName', 'answers', 'startedAt', 'submittedAt', 'durationMs']) &&
            request.resource.data.uid == studentId &&
            request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80 &&
            request.resource.data.answers is list &&
            get(/databases/$(database)/documents/classes/$(classId)/assignments/$(assignmentId)).data.kind == 'exam' &&
            request.resource.data.answers.size() ==
              get(/databases/$(database)/documents/classes/$(classId)/assignments/$(assignmentId)).data.questionCount &&
            request.resource.data.startedAt is int && request.resource.data.submittedAt is int &&
            request.resource.data.durationMs is int && request.resource.data.durationMs >= 0;
          allow update: if false;
          allow delete: if isClassTeacher(classId);
        }

        match /submissions/{studentId} {
          allow read: if request.auth.uid == studentId || isClassTeacher(classId) || isAdmin();
          allow create, update: if request.auth.uid == studentId && isClassMember(classId) &&
            isValidSubmission(request.resource.data);
          allow delete: if isClassTeacher(classId);
        }
      }
    }

    // Join code -> class lookup. Readable one code at a time, never listable.
    match /classCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.teacherId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.joinCode == code;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // A teacher's own tests and matching sets. Students get a copy inside
    // each assignment, so only the owner reads these.
    // Öğretmen soru bankası: only the owner reads and writes their questions.
    function isValidTeacherQuestion(d) {
      return d.keys().hasOnly(['ownerId', 'ownerName', 'grade', 'level', 'subject', 'categoryId', 'topic',
                               'outcomeCode', 'outcomeText', 'prompt', 'options', 'correctIndex',
                               'explanation', 'difficulty', 'poolSubmittedAt', 'createdAt', 'updatedAt']) &&
        d.ownerId == request.auth.uid &&
        d.ownerName is string && d.ownerName.size() <= 80 &&
        d.grade is int && d.grade >= 1 && d.grade <= 12 &&
        d.subject is string && d.subject.size() <= 60 &&
        d.categoryId is string && d.categoryId.size() > 0 && d.categoryId.size() <= 120 &&
        d.topic is string && d.topic.size() <= 200 &&
        d.prompt is string && d.prompt.size() > 0 && d.prompt.size() <= 1000 &&
        d.options is list && d.options.size() == 4 &&
        d.correctIndex is int && d.correctIndex >= 0 && d.correctIndex < 4 &&
        d.explanation is string && d.explanation.size() <= 1000 &&
        d.difficulty is int && d.difficulty >= 1 && d.difficulty <= 5 &&
        d.createdAt is int && d.updatedAt is int;
    }

    match /teacherQuestions/{questionId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isTeacherOrAdmin() && isValidTeacherQuestion(request.resource.data);
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid &&
        isValidTeacherQuestion(request.resource.data);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /teacherContent/{contentId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isTeacherOrAdmin() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type in ['quiz', 'match'] &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.type == resource.data.type;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Subscriptions are only ever written by Cloud Functions (payment
      // webhooks) using the Admin SDK, which bypasses these rules entirely.
      allow write: if false;
    }
  }
}
